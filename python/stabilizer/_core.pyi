from typing import Any, Optional, Sequence

import numpy as np
import numpy.typing as npt

Gate = tuple  # ("c", control, target) | ("h", q) | ("p", q) | ("m", q)
Outcome = tuple[int, int, bool]  # (qubit, outcome, deterministic)

class Tableau:
    def __init__(self, n: int, seed: Optional[int] = None) -> None: ...
    @staticmethod
    def from_stabilizers(stabilizers: Sequence[str], seed: Optional[int] = None) -> Tableau: ...
    @property
    def n(self) -> int: ...
    @property
    def num_words(self) -> int: ...
    def reseed(self, seed: Optional[int] = None) -> None: ...
    def get_x(self, row: int, col: int) -> int: ...
    def get_z(self, row: int, col: int) -> int: ...
    def get_r(self, row: int) -> int: ...
    def set_x(self, row: int, col: int, val: int) -> None: ...
    def set_z(self, row: int, col: int, val: int) -> None: ...
    def set_r(self, row: int, val: int) -> None: ...
    def row_to_pauli(self, row: int) -> str: ...
    def set_row_from_pauli(self, row: int, pauli_str: str) -> None: ...
    def rowsum(self, h: int, i: int) -> None: ...
    def to_stabilizer_string(self, include_destabilizers: bool = False) -> str: ...
    def copy(self) -> Tableau: ...
    def __copy__(self) -> Tableau: ...
    def __deepcopy__(self, memo: Any) -> Tableau: ...
    def __eq__(self, other: object) -> bool: ...
    def apply_cnot(self, control: int, target: int) -> None: ...
    def apply_h(self, qubit: int) -> None: ...
    def apply_s(self, qubit: int) -> None: ...
    def measure(self, qubit: int, force: Optional[int] = None) -> int: ...
    def is_deterministic(self, qubit: int) -> bool: ...
    def peek(self, qubit: int) -> Optional[int]: ...
    def stabilizers(self) -> list[str]: ...
    def destabilizers(self) -> list[str]: ...
    def canonical_stabilizers(self) -> list[str]: ...
    def same_state(self, other: Tableau) -> bool: ...
    def check_invariants(self) -> None: ...
    def to_numpy(self) -> tuple[npt.NDArray[np.uint8], npt.NDArray[np.uint8], npt.NDArray[np.uint8]]: ...
    def apply_circuit(self, circuit: Circuit) -> list[Outcome]: ...

class Circuit:
    def __init__(self, n: int) -> None: ...
    @property
    def n(self) -> int: ...
    def cnot(self, control: int, target: int) -> None: ...
    def h(self, qubit: int) -> None: ...
    def p(self, qubit: int) -> None: ...
    def measure(self, qubit: int) -> None: ...
    def extend(self, other: Circuit) -> None: ...
    def gates(self) -> list[Gate]: ...
    def __len__(self) -> int: ...
    def is_unitary(self) -> bool: ...
    def inverse(self) -> Circuit: ...
    def rounds(self) -> list[tuple[str, int]]: ...
    def tableau(self, seed: Optional[int] = None) -> Tableau: ...
    def to_chp(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...

class MixedTableau:
    def __init__(self, n: int, rank: int, seed: Optional[int] = None) -> None: ...
    @staticmethod
    def from_pure(tableau: Tableau, seed: Optional[int] = None) -> MixedTableau: ...
    @staticmethod
    def from_stabilizers(n: int, stabilizers: Sequence[str], seed: Optional[int] = None) -> MixedTableau: ...
    @property
    def n(self) -> int: ...
    @property
    def rank(self) -> int: ...
    def apply_cnot(self, control: int, target: int) -> None: ...
    def apply_h(self, qubit: int) -> None: ...
    def apply_s(self, qubit: int) -> None: ...
    def measure(self, qubit: int, force: Optional[int] = None) -> int: ...
    def peek(self, qubit: int) -> Optional[int]: ...
    def discard(self, qubit: int) -> None: ...
    def stabilizers(self) -> list[str]: ...
    def canonical_stabilizers(self) -> list[str]: ...
    def rows(self) -> list[str]: ...
    def check_invariants(self) -> None: ...
    def copy(self) -> MixedTableau: ...

class ProductStateSimulator:
    def __init__(
        self, n: int, blocks: Sequence[tuple[Sequence[int], npt.ArrayLike]], seed: Optional[int] = None
    ) -> None: ...
    @property
    def n(self) -> int: ...
    @property
    def num_measurements(self) -> int: ...
    def apply_cnot(self, control: int, target: int) -> None: ...
    def apply_h(self, qubit: int) -> None: ...
    def apply_s(self, qubit: int) -> None: ...
    def probability(self, qubit: int) -> float: ...
    def measure(self, qubit: int, force: Optional[int] = None) -> int: ...

class NonStabilizerSimulator:
    def __init__(self, n: int, seed: Optional[int] = None) -> None: ...
    @property
    def n(self) -> int: ...
    @property
    def num_terms(self) -> int: ...
    def apply_cnot(self, control: int, target: int) -> None: ...
    def apply_h(self, qubit: int) -> None: ...
    def apply_s(self, qubit: int) -> None: ...
    def apply_t(self, qubit: int) -> None: ...
    def apply_unitary(self, matrix: npt.ArrayLike, qubits: Sequence[int]) -> None: ...
    def probability(self, qubit: int) -> float: ...
    def probability_pauli(self, pauli_str: str) -> float: ...
    def measure(self, qubit: int, force: Optional[int] = None) -> int: ...
    def measure_pauli(self, pauli_str: str, force: Optional[int] = None) -> int: ...
    def stabilizers(self) -> list[str]: ...

def g(x1: int, z1: int, x2: int, z2: int) -> int: ...
def pauli_product(a: str, b: str) -> str: ...
def pauli_commutes(a: str, b: str) -> bool: ...
def parse_chp(text: str) -> Circuit: ...
def run_chp(text: str, seed: Optional[int] = None) -> tuple[list[Outcome], Tableau]: ...
def random_circuit(n: int, beta: float, seed: Optional[int] = None) -> Circuit: ...
def time_measurements(n: int, beta: float, seed: Optional[int] = None) -> float: ...
def _num_stabilizer_states(n: int) -> str: ...
def log2_num_stabilizer_states(n: int) -> float: ...
def inner_product(psi: Tableau, phi: Tableau) -> float: ...
def inner_product_exponent(psi: Tableau, phi: Tableau) -> Optional[int]: ...
def canonical_form(circuit: Circuit, method: str = "gauss") -> Circuit: ...
def canonical_rounds(circuit: Circuit, method: str = "gauss") -> list[tuple[str, Circuit]]: ...
def to_identity_circuit(tableau: Tableau, method: str = "gauss") -> Circuit: ...
def synthesize(tableau: Tableau, method: str = "gauss") -> Circuit: ...
def lemma6_hadamards(tableau: Tableau) -> list[int]: ...
def lemma7(matrix: Sequence[Sequence[int]]) -> tuple[list[int], list[list[int]]]: ...
def cnot_synthesis(
    matrix: Sequence[Sequence[int]], method: str = "pmh", section_size: Optional[int] = None
) -> list[tuple[int, int]]: ...
def determinate_outcome(circuit: Circuit, qubit: int) -> Optional[int]: ...
